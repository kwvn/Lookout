# copy to .env and never share it
DISCORD_TOKEN=

# image filter. 0-1, higher = fewer false alarms but more misses
NSFW_THRESHOLD=0.6
MAX_IMAGE_MB=10

# reports
REPORT_WINDOW_MINUTES=10
REPORT_COOLDOWN_SECONDS=120

# days before records get deleted
RETENTION_DAYS=90

# optional
HEARTBEAT_URL=
TOPGG_TOKEN=
SUPPORT_GUILD_ID=
